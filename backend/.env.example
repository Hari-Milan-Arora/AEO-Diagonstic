# ═══ AEO Diagnostic Engine — Environment Configuration ═══

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Mode: set to "false" to use real API calls
SIMULATION_MODE=true

# AI API Keys (optional — only needed when SIMULATION_MODE=false)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Ollama Configuration (optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ENABLED=true
